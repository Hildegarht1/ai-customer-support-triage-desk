    {
      "parameters": {
        "jsCode": "const message = $json.message?.text || \"\";\nconst chatId = String($json.message?.chat?.id || \"\");\nconst adminChatId = \"YOUR_ADMIN_CHAT_ID\";\n\nif (chatId !== adminChatId) {\n  return [\n    {\n      json: {\n        valid_command: false,\n        error: \"Unauthorized chat\",\n        chat_id: chatId,\n        raw_command: message\n      }\n    }\n  ];\n}\n\nconst parts = message.trim().split(/\\s+/);\nconst action = (parts[0] || \"\").toUpperCase();\nconst ticketId = parts[1] || \"\";\n\nconst allowedActions = [\"APPROVE\", \"REJECT\", \"ESCALATE\"];\n\nconst validCommand =\n  allowedActions.includes(action) &&\n  /^TCK-\\d{8}-\\d{6}$/.test(ticketId);\n\nreturn [\n  {\n    json: {\n      valid_command: validCommand ? \"true\" : \"false\",\n      action,\n      ticket_id: ticketId,\n      admin_chat_id: chatId,\n      raw_command: message,\n      error: validCommand ? \"\" : \"Invalid command format\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "20f231c5-7b88-4b21-b7e5-2e413dfa851e",
